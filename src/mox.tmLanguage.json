{
  "name": "mox",
  "scopeName": "source.mox",
  "fileTypes": ["mox"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#directives" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#generics" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.mox", "match": "//.*$" },
        { "name": "comment.block.mox", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mox",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.mox", "match": "\\\\." },
        { "name": "constant.other.placeholder.mox", "match": "\\{\\}" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.mox", "match": "\\b0x[0-9a-fA-F_]+(?:[iu](?:8|16|32|64|128))?\\b" },
        { "name": "constant.numeric.float.mox", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*f?\\b" },
        { "name": "constant.numeric.integer.mox", "match": "\\b[0-9][0-9_]*(?:[iu](?:8|16|32|64|128)|f)?\\b" }
      ]
    },
    "directives": {
      "name": "keyword.other.directive.mox",
      "match": "#[A-Za-z_][A-Za-z0-9_]*"
    },
    "keywords": {
      "patterns": [
        { "name": "storage.type.mox", "match": "\\b(fn|struct|enum|const)\\b" },
        { "name": "keyword.control.mox", "match": "\\b(if|else|while|for|switch|case|break|continue|return|defer|import)\\b" },
        { "name": "constant.language.mox", "match": "\\b(true|false|null)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.mox", "match": "\\b([iu](?:8|16|32|64|128)|f32|f64|bool|void|__ast_ptr|__type_ptr)\\b" },
        { "name": "entity.name.type.mox", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "functions": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.mox" } }
    },
    "generics": {
      "name": "variable.parameter.generic.mox",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
    },
    "operators": {
      "name": "keyword.operator.mox",
      "match": ":=|==|!=|<=|>=|&&|\\|\\||[-+*/%=<>!&|^~]"
    }
  }
}

---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GITHUB } from '../lib/site.ts';
import '../styles/global.css';

const { frontmatter } = Astro.props;
const title: string = frontmatter.title;
const description: string = frontmatter.description;
const isHome = Astro.url.pathname === '/';

const siteUrl = Astro.site?.href;

const jsonLd = isHome && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Mox programming language',
      alternateName: 'Mox',
      url: siteUrl,
      description,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Mox',
      alternateName: 'Mox programming language',
      description,
      url: siteUrl,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows, Linux',
      downloadUrl: 'https://github.com/Morglod/mox/releases/latest',
      codeRepository: GITHUB,
      programmingLanguage: 'Mox',
      license: 'https://opensource.org/licenses/MIT',
      author: {
        '@type': 'Person',
        name: 'Morglod',
        url: 'https://github.com/Morglod',
      },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} jsonLd={jsonLd} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
